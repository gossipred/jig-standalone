<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jj.jig.ui.jig.JigListController"
      styleClass="jig-list-root">

    <!-- Toolbar -->
    <HBox styleClass="jig-toolbar" alignment="CENTER_LEFT" spacing="8">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <Label text="JTs / 治模具列表" styleClass="jig-list-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search / 搜尋..." styleClass="jig-search-field" prefWidth="220"/>
        <ComboBox fx:id="statusFilter" prefWidth="210"/>
        <Button text="↺  Refresh" styleClass="jig-btn-outline" onAction="#handleRefresh"/>
        <Button text="⇩  Export CSV" styleClass="jig-btn-outline" onAction="#handleExportCsv"/>
        <Button text="⇪  Import CSV" styleClass="jig-btn-outline" onAction="#handleImportCsv"/>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="detailBtn"       text="☰  Details / 詳情"         styleClass="jig-btn-outline"  onAction="#handleViewDetail"    disable="true"/>
        <Button fx:id="changeStatusBtn" text="⇄  Change Status / 改狀態" styleClass="jig-btn-outline"  onAction="#handleChangeStatus"  disable="true"/>
        <Button fx:id="newJigBtn"       text="+  New JT / 新增"          styleClass="jig-btn-primary"  onAction="#handleNewJig"/>
        <Button fx:id="editJigBtn"      text="✎  Edit / 編輯"            styleClass="jig-btn-outline"  onAction="#handleEditJig"       disable="true"/>
        <Button fx:id="deleteJigBtn"    text="✕  Delete / 刪除"          styleClass="jig-btn-danger"   onAction="#handleDeleteJig"     disable="true"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="jigsTable" VBox.vgrow="ALWAYS" styleClass="jig-table">
        <columns>
            <TableColumn fx:id="colJigNo"         text="JT No."               prefWidth="140"/>
            <TableColumn fx:id="colClassification" text="Class."              prefWidth="80"/>
            <TableColumn fx:id="colModelName"      text="Model Name / 型號"    prefWidth="140"/>
            <TableColumn fx:id="colJigName"        text="JT Name / 治模具名稱" prefWidth="200"/>
            <TableColumn fx:id="colCustomer"       text="Customer / 客戶"      prefWidth="100"/>
            <TableColumn fx:id="colLine"           text="Line / 線別"          prefWidth="80"/>
            <TableColumn fx:id="colQty"            text="Qty"                  prefWidth="50"/>
            <TableColumn fx:id="colStatus"         text="Status / 狀態"        prefWidth="135"/>
            <TableColumn fx:id="colDueDate"        text="Due Date / 到期日"    prefWidth="115"/>
            <TableColumn fx:id="colDri"            text="DRI"                  prefWidth="90"/>
            <TableColumn fx:id="colNote"           text="Note / 備註"          prefWidth="200"/>
        </columns>
        <placeholder>
            <Label text="No JTs found / 尚無治模具資料" styleClass="jig-placeholder-label"/>
        </placeholder>
    </TableView>

    <!-- Status Bar -->
    <HBox styleClass="jig-statusbar" alignment="CENTER_LEFT">
        <padding><Insets top="5" right="16" bottom="5" left="16"/></padding>
        <Label fx:id="statusBarLabel" styleClass="jig-statusbar-label" text=""/>
    </HBox>

</VBox>
