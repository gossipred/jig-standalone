<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jj.jig.ui.log.LogViewController"
      styleClass="jig-list-root">

    <!-- Toolbar -->
    <HBox styleClass="jig-toolbar" alignment="CENTER_LEFT" spacing="8">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <Label text="Logs / 異動日誌" styleClass="jig-list-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <DatePicker fx:id="fromDatePicker" promptText="From / 起始日" prefWidth="145"/>
        <Label text="→" styleClass="jig-form-hint"/>
        <DatePicker fx:id="toDatePicker" promptText="To / 結束日" prefWidth="145"/>
        <ComboBox fx:id="actionTypeFilter" prefWidth="185" promptText="All Actions / 全部動作"/>
        <ComboBox fx:id="operatorFilter"   prefWidth="140" promptText="All Operators / 全部"/>
        <Button text="⌕  Search / 搜尋" styleClass="jig-btn-primary"  onAction="#handleSearch"/>
        <Button text="✕  Clear / 清除"  styleClass="jig-btn-outline"  onAction="#handleClear"/>
        <Separator orientation="VERTICAL"/>
        <Button text="⇩  Export CSV"   styleClass="jig-btn-outline"  onAction="#handleExportCsv"/>
    </HBox>

    <!-- Log Table -->
    <TableView fx:id="logsTable" VBox.vgrow="ALWAYS" styleClass="jig-table">
        <columns>
            <TableColumn fx:id="colDate"     text="Date / 日期時間"    prefWidth="160"/>
            <TableColumn fx:id="colJigNo"    text="JT No."            prefWidth="130"/>
            <TableColumn fx:id="colJigName"  text="JT Name / 名稱"    prefWidth="180"/>
            <TableColumn fx:id="colAction"   text="Action / 動作"     prefWidth="140"/>
            <TableColumn fx:id="colDetails"  text="Details / 詳情"    prefWidth="260"/>
            <TableColumn fx:id="colOperator" text="Operator / 操作者" prefWidth="110"/>
        </columns>
        <placeholder>
            <Label text="No records — use filters above to search / 使用上方篩選條件搜尋"
                   styleClass="jig-placeholder-label"/>
        </placeholder>
    </TableView>

    <!-- Status bar -->
    <HBox alignment="CENTER_LEFT" styleClass="jig-log-statusbar">
        <padding><Insets top="5" right="16" bottom="5" left="16"/></padding>
        <Label fx:id="countLabel" styleClass="jig-form-hint" text=""/>
    </HBox>

</VBox>
