<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainRoot" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jj.jig.ui.main.MainController"
            styleClass="main-root">

    <top>
        <VBox>
            <HBox styleClass="main-topbar" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
                <Label fx:id="welcomeLabel" styleClass="topbar-welcome"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="adminBtn" text="&#x2699;  Admin Management / 管理員設定"
                        styleClass="topbar-admin-btn"
                        onAction="#handleOpenAdminManagement"
                        visible="false" managed="false"/>
                <Button text="Logout / 離開" styleClass="topbar-logout-btn"
                        onAction="#handleLogout"/>
            </HBox>
            <Separator/>
            <!-- Nav Bar -->
            <HBox styleClass="main-navbar" alignment="CENTER_LEFT" spacing="4">
                <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
                <Button fx:id="navJigsBtn"  text="☰  JTs / 治模具列表"  styleClass="main-nav-btn" onAction="#handleNavJigs"/>
                <Button fx:id="navLogsBtn"  text="⊟  Logs / 異動日誌"   styleClass="main-nav-btn" onAction="#handleNavLogs"/>
                <Button fx:id="navStatsBtn" text="◑  Stats / 統計"       styleClass="main-nav-btn" onAction="#handleNavStats"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <!-- center is set dynamically by MainController -->

</BorderPane>
